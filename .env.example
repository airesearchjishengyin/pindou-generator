# AI 像素化 (可选功能) 凭据模板
# 用法: cp .env.example .env 然后填入你自己的值
# !!! .env 已被 .gitignore 排除, 永远不要把真实 key 提交到仓库 !!!
# 支持任何 OpenAI 兼容的图像编辑接口 (POST /v1/images/edits)

OPENAI_API_KEY=sk-xxxx你的key
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 账户系统 (登录+余额) ----
# 会话 Cookie 签名密钥: 随机长字符串, 换了会导致所有人重新登录
PINDOU_SESSION_SECRET=换成随机长字符串
# 公网地址 (OAuth 回调用, 须与 Google/Microsoft 后台登记的 redirect URI 一致)
PINDOU_BASE_URL=https://你的域名
# ---- Google 登录 (console.cloud.google.com → OAuth 同意屏幕+凭据 → OAuth 客户端ID, 免费) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---- Microsoft 登录 (portal.azure.com → Microsoft Entra ID → 应用注册, 免费; 支持个人+组织账号) ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
